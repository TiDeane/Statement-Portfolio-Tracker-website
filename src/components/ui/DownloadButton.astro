---
/**
 * The main download button. One variant per system is rendered; CSS shows the visitor's (see
 * `.os-show` in tailwind.css). The generic one, shown without JavaScript or on a phone, opens the
 * download page.
 */
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import { downloadUrl, releaseAtBuild } from '~/utils/release';

export interface Props {
  size?: 'lg' | 'sm';
  class?: string;
}

const { size = 'lg', class: className = '' } = Astro.props;
const latest = await releaseAtBuild();
const base = twMerge(
  'btn-primary gap-2.5 shadow-lg shadow-primary/30',
  size === 'lg' ? 'text-lg px-7 py-4 md:px-8' : 'text-sm px-5 py-2.5 shadow-none',
  className
);
const icon = size === 'lg' ? 'w-6 h-6' : 'w-4 h-4';
---

<a class:list={[base, 'os-show os-windows']} href={downloadUrl(latest, 'windows')} data-asset="windows">
  <Icon name="tabler:brand-windows" class={icon} /> Download for Windows
</a>
<a class:list={[base, 'os-show os-mac']} href={downloadUrl(latest, 'mac-arm')} data-asset="mac-arm">
  <Icon name="tabler:brand-apple" class={icon} /> Download for Mac
</a>
<a class:list={[base, 'os-show os-linux']} href={downloadUrl(latest, 'linux')} data-asset="linux">
  <Icon name="tabler:brand-ubuntu" class={icon} /> Download for Linux
</a>
<a class:list={[base, 'os-default']} href="/download">
  <Icon name="tabler:download" class={icon} /> Download
</a>
