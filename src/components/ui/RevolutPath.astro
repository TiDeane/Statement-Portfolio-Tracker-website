---
/**
 * Where the statement is in the Revolut app, drawn as a phone-sized card. Deliberately not a
 * screenshot of Revolut's app: no logo, no look-alike. The path is drawn as a numbered timeline
 * (plain text on a line, no filled rows or chevrons) so nothing in it looks like a button.
 */
import { Icon } from 'astro-icon/components';
import { REVOLUT_PATH as path, STATEMENT_CHOICES, STATEMENT_TRANSFER_TIP } from '~/data/statement';
---

<div
  class="mx-auto w-full max-w-sm rounded-[2rem] border border-gray-300 dark:border-white/10 bg-white dark:bg-[#0b1020] p-6 shadow-2xl shadow-black/20 dark:shadow-black/60"
>
  <p class="text-xs font-semibold uppercase tracking-wider text-muted">In the Revolut app, tap</p>
  <ol class="mt-5">
    {
      path.map((step, i) => (
        <li class="relative flex gap-4 pb-5 last:pb-0">
          {i < path.length - 1 && (
            <span
              class="absolute left-3 top-6 bottom-0 w-px -translate-x-1/2 bg-gray-300 dark:bg-white/15"
              aria-hidden="true"
            />
          )}
          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-primary text-xs font-semibold text-white">
            {i + 1}
          </span>
          <div class="pt-0.5">
            <p class="text-sm font-medium text-gray-900 dark:text-white">{step}</p>
            {i === path.length - 1 && (
              <dl class="mt-2 space-y-1 text-sm">
                {STATEMENT_CHOICES.map(({ label, value }) => (
                  <div class="flex gap-2">
                    <dt class="text-muted">{label}:</dt>
                    <dd class="font-semibold text-primary">{value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </li>
      ))
    }
  </ol>
  <div class="mt-6 border-t border-gray-200 dark:border-white/10 pt-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted">You get</p>
    <div
      class="mt-3 flex items-center gap-3 rounded-xl border border-dashed border-gray-300 dark:border-white/20 px-4 py-3"
    >
      <Icon name="tabler:file-type-csv" class="w-8 h-8 shrink-0 text-green-600 dark:text-green-500" />
      <div class="min-w-0">
        <p class="truncate font-mono text-sm text-gray-900 dark:text-white">account-statement.csv</p>
        <p class="text-xs text-muted">Ready to drop into the app</p>
      </div>
    </div>
    <p class="mt-3 flex items-start gap-2 text-xs text-muted">
      <Icon name="tabler:send" class="mt-0.5 w-4 h-4 shrink-0" />
      {STATEMENT_TRANSFER_TIP}
    </p>
  </div>
</div>
