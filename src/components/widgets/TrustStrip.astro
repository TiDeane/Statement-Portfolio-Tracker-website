---
import { Icon } from 'astro-icon/components';

const items = [
  { icon: 'tabler:gift', text: 'Free and open source' },
  { icon: 'tabler:device-desktop', text: 'Runs on your computer' },
  { icon: 'tabler:user-off', text: 'No account, no sign-up' },
  { icon: 'tabler:file-spreadsheet', text: 'Updates your Excel file' },
];
---

<section class="mx-auto max-w-5xl px-4 md:px-6 pt-16 md:pt-20">
  <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-4 text-sm md:text-base text-muted">
    {
      items.map(({ icon, text }) => (
        <li class="flex items-center gap-2 md:justify-center">
          <Icon name={icon} class="w-5 h-5 shrink-0 text-primary" />
          {text}
        </li>
      ))
    }
  </ul>
</section>
