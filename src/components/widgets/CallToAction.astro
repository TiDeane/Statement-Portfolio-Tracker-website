---
import { Image } from 'astro:assets';
import DownloadButton from '~/components/ui/DownloadButton.astro';
import icon from '~/assets/images/app-icon.png';
---

<section class="mx-auto max-w-7xl px-4 md:px-6 py-24 md:py-36">
  <div class="card relative px-6 py-16 md:py-24 text-center">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute left-1/2 top-full h-[30rem] w-[50rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/30 blur-[120px]"
      >
      </div>
    </div>
    <div class="relative">
      <Image
        src={icon}
        alt=""
        width={80}
        height={80}
        class="mx-auto w-20 h-20 rounded-2xl shadow-xl shadow-primary/30"
      />
      <h2 class="mt-8 text-4xl md:text-5xl font-bold tracking-tighter text-gray-900 dark:text-white">
        See where your money stands.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">Free. No account. Nothing to set up.</p>
      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
        <DownloadButton />
        <a href="/download" class="btn-secondary text-lg px-7 py-4">All downloads</a>
      </div>
    </div>
  </div>
</section>
