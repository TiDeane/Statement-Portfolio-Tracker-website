---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { ISSUES_URL, REPO_URL } from '~/navigation';

const columns = [
  {
    title: 'App',
    links: [
      { text: 'Download', href: '/download' },
      { text: 'How it works', href: '/#how-it-works' },
      { text: 'Guide', href: '/guide' },
      { text: 'Questions', href: '/#faq' },
    ],
  },
  {
    title: 'Project',
    links: [
      { text: 'Source code', href: REPO_URL },
      { text: 'All versions', href: `${REPO_URL}/releases` },
      { text: 'Report a problem', href: ISSUES_URL },
      { text: 'Licence (GPL-3.0)', href: `${REPO_URL}/blob/main/LICENSE` },
    ],
  },
];
---

<footer class="relative border-t border-gray-200 dark:border-slate-800 not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16 dark:text-slate-300">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div class="max-w-md">
        <a href="/" aria-label="Home"><Logo /></a>
        <p class="mt-4 text-sm text-muted leading-relaxed">
          An unofficial app for Revolut stock statements. Not made by, affiliated with or endorsed by Revolut. Not
          financial advice. Prices come from Yahoo Finance and may be delayed or wrong; Yahoo's terms apply to them.
        </p>
      </div>
      {
        columns.map(({ title, links }) => (
          <div>
            <p class="text-sm font-semibold text-gray-900 dark:text-white">{title}</p>
            <ul class="mt-3 space-y-2 text-sm">
              {links.map(({ text, href }) => (
                <li>
                  <a class="text-muted hover:text-primary dark:hover:text-white transition" href={href}>
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div
      class="mt-10 pt-6 border-t border-gray-200 dark:border-slate-800 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between text-sm text-muted"
    >
      <p>&copy; <span id="currentYear">2026</span> Tiago Deane · Free and open source</p>
      <p class="inline-flex items-center gap-1.5">
        <Icon name="tabler:shield-lock" class="w-4 h-4" />
        This site uses no cookies and no tracking.
      </p>
    </div>
  </div>
</footer>
